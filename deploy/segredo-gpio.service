[Unit]
Description=Segredo do Bandido GPIO Controller
After=network-online.target segredo-stack.service
Wants=network-online.target segredo-stack.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO_DIR__
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-__REPO_DIR__/.env
ExecStart=__REPO_DIR__/.venv/bin/python -m hardware.controller
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
