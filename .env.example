# API
HOST=0.0.0.0
PORT=8000
# Origens do frontend liberadas no CORS, separadas por virgula
CORS_ORIGINS=http://localhost:5500

# Banco SQLite (dentro de api/)
DB_PATH=api/segredo.db

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Regras do jogo (3 perguntas por partida e fixo, nao configuravel)
INITIAL_TIME_SECONDS=180
TIME_PENALTY_SECONDS=20
ROUND_TIME_SECONDS=30

# Senha de administracao (trocar)
ADMIN_PASSWORD=change-me
